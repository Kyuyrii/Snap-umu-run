#!/bin/bash

# Get the largest icon size from ico file
get_largest_icon_size() {
    local ico_file="$1"
    local max_size=0

    while IFS= read -r line; do
        if [[ $line =~ --width=([0-9]+) ]]; then
            size="${BASH_REMATCH[1]}"
            [ "$size" -gt "$max_size" ] && max_size=$size
        fi
    done < <(icotool -l "$ico_file" 2>/dev/null)

    echo "$max_size"
}

# Get game name from executable filename, without extension
get_game_name() {
    local filename=$(basename "$1")
    echo "${filename%.*}"
}

# Get desktop directory
get_desktop_dir() {
    local desktop="$HOME/Desktop"
    local config="$HOME/.config/user-dirs.dirs"

    if [ -f "$config" ]; then
        local xdg=$(grep "^XDG_DESKTOP_DIR=" "$config" | cut -d'=' -f2- | tr -d '"')
        [ -n "$xdg" ] && desktop="${xdg/#\$HOME/$HOME}"
    fi

    echo "$desktop"
}

EXEC_FILE="$1"

# Get game name
GAME_NAME=$(get_game_name "$EXEC_FILE")
SAFE_NAME=$(echo "$GAME_NAME" | tr ' ' '_' | tr '[:upper:]' '[:lower:]' | sed 's/[^a-zA-Z0-9_-]/_/g')

# Set paths
EXEC_DIR=$(dirname "$EXEC_FILE")
ICON_PATH="$EXEC_DIR/$SAFE_NAME.png"

if snapctl is-connected home; then
    DOT_DESKTOP_FILE="$(get_desktop_dir)/umu-run-$SAFE_NAME.desktop"
else
    mkdir -p "$SNAP_USER_COMMON/Desktop"
    DOT_DESKTOP_FILE="$SNAP_USER_COMMON/Desktop/umu-run-$SAFE_NAME.desktop"
fi

# Extract icon
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/umu-ddc"
mkdir -p "$CACHE_DIR"
cd "$CACHE_DIR"

if wrestool -x -t 14 "$EXEC_FILE" > temp.ico 2>/dev/null; then
    LARGEST_SIZE=$(get_largest_icon_size "temp.ico")

    if [ -n "$LARGEST_SIZE" ] && [ "$LARGEST_SIZE" -gt 0 ]; then
        icotool -x -w "$LARGEST_SIZE" -h "$LARGEST_SIZE" "temp.ico" 2>/dev/null
        PNG_FILE=$(find "$CACHE_DIR" -maxdepth 1 -name "*.png" | head -1)

        if [ -n "$PNG_FILE" ]; then
            cp "$PNG_FILE" "$ICON_PATH"
        fi
    fi
fi

# Clean cache
rm -rf "$CACHE_DIR"

# Check for Wine prefix and build exec line
WINEPREFIX=$(dirname "$EXEC_FILE")
FOUND_PREFIX=""

while [ "$WINEPREFIX" != "/" ] && [ "$WINEPREFIX" != "." ]; do
    if [ -d "$WINEPREFIX/drive_c" ]; then
        FOUND_PREFIX="$WINEPREFIX"
        break
    fi
    WINEPREFIX=$(dirname "$WINEPREFIX")
done

if [ -n "$FOUND_PREFIX" ]; then
    EXECC_LINE="env WINEPREFIX=\"$FOUND_PREFIX\" snap run umu-run \"$EXEC_FILE\""
else
    EXECC_LINE="snap run umu-run \"$EXEC_FILE\""
fi

# Get executable basename for StartupWMClass
EXEC_BASENAME=$(basename "$EXEC_FILE")

# Create desktop file
cat > "$DOT_DESKTOP_FILE" << EOF
[Desktop Entry]
Name=$GAME_NAME
Exec=$EXECC_LINE
Icon=$ICON_PATH
Path=$EXEC_DIR
StartupWMClass=$EXEC_BASENAME
Categories=Game;
Keywords=gaming;
Type=Application
StartupNotify=false
Terminal=true
EOF

chmod +x "$DOT_DESKTOP_FILE"
